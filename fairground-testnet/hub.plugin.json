{
  "schema_version": 1,
  "contract_version": "SH-SOFTWARE-0.6/5",
  "id": "io.sprintray.fairground-testnet",
  "name": "Fairground Testnet",
  "version": "1.7.9",
  "description": "Сезон 3: сделки ключом Hub, браузерный отпечаток на каждый запрос.",
  "author": "sprintray",
  "presentation": {
    "display_name": "Fairground Testnet",
    "description": "Сделки ключом Hub. Ads не нужен.",
    "assets": {
      "icon": "assets/icon.png",
      "image": "assets/image.png"
    }
  },
  "catalog": {
    "sections": ["testnet"]
  },
  "compatibility": {
    "hub": ">=0.6.22",
    "python": ">=3.12,<3.13",
    "os": ["darwin"]
  },
  "runtime": {
    "type": "python",
    "entrypoint": "plugin.main:run",
    "protocol": "soft-hub-jsonl/1",
    "state_model": "externally_reconciled",
    "requirements": "requirements.txt",
    "safe_stop": true,
    "heartbeat_seconds": 15
  },
  "permissions": {
    "secrets": [
      "evm_private_key",
      "proxy"
    ],
    "network": [
      "fairground.fi",
      "api.fairground.fi",
      "metrics.fairground.fi",
      "incentives.fairground.fi",
      "waitlist.fairground.fi",
      "sepolia-rollup.arbitrum.io",
      "arb-sepolia.g.alchemy.com"
    ],
    "chains": [421614],
    "financial_risk": "testnet",
    "browser": false,
    "local_services": []
  },
  "actions": [
    {
      "id": "farm",
      "name": "Работа",
      "description": "Open/close ключом Hub.",
      "risk": "testnet_write",
      "account_mode": "one_or_more",
      "permissions": {
        "secrets": ["evm_private_key", "proxy"]
      },
      "resources": {
        "account": ["private_key", "proxy"],
        "settings": []
      },
      "output": {
        "mode": "account_table",
        "title": "Работа",
        "primary_kind": "account_summary",
        "columns": [
          {"key": "rounds", "title": "Кругов", "type": "integer", "aggregate": "sum"},
          {"key": "volume", "title": "Объём", "type": "decimal_string"},
          {"key": "waitlist", "title": "WL", "type": "boolean"},
          {"key": "style", "title": "Стиль", "type": "string"},
          {"key": "planned", "title": "План", "type": "integer", "aggregate": "avg"}
        ]
      },
      "options": {
        "type": "object",
        "properties": {
          "account_concurrency": {
            "type": "integer",
            "title": "Параллельные аккаунты",
            "description": "Сколько кошельков сразу. 20 — все выбранные.",
            "default": 3,
            "minimum": 1,
            "maximum": 20,
            "multipleOf": 1,
            "x-ui": {"group": "Выполнение", "order": 0, "unit": "аккаунтов"}
          },
          "trades_from": {
            "type": "integer",
            "title": "Кругов на аккаунт",
            "description": "Сколько open/close кругов. Число случайное внутри диапазона.",
            "default": 8,
            "minimum": 1,
            "maximum": 40,
            "multipleOf": 1,
            "x-ui": {
              "group": "Фарм",
              "order": 10,
              "unit": "кругов",
              "control": "dual_range",
              "range": {"id": "trades", "role": "from"}
            }
          },
          "trades_to": {
            "type": "integer",
            "title": "Кругов на аккаунт",
            "description": "Сколько open/close кругов. Число случайное внутри диапазона.",
            "default": 16,
            "minimum": 1,
            "maximum": 40,
            "multipleOf": 1,
            "x-ui": {
              "group": "Фарм",
              "order": 20,
              "unit": "кругов",
              "control": "dual_range",
              "range": {"id": "trades", "role": "to"}
            }
          },
          "margin_from": {
            "type": "integer",
            "title": "Маржа от баланса",
            "description": "Доля test USDC на круг, ступеньками как в UI.",
            "default": 12,
            "minimum": 5,
            "maximum": 90,
            "multipleOf": 1,
            "x-ui": {
              "group": "Фарм",
              "order": 30,
              "unit": "%",
              "control": "dual_range",
              "range": {"id": "margin", "role": "from"}
            }
          },
          "margin_to": {
            "type": "integer",
            "title": "Маржа от баланса",
            "description": "Доля test USDC на круг, ступеньками как в UI.",
            "default": 48,
            "minimum": 5,
            "maximum": 90,
            "multipleOf": 1,
            "x-ui": {
              "group": "Фарм",
              "order": 40,
              "unit": "%",
              "control": "dual_range",
              "range": {"id": "margin", "role": "to"}
            }
          },
          "hold_from": {
            "type": "integer",
            "title": "Удержание позиции",
            "description": "Секунд до закрытия. Каждый круг своё время.",
            "default": 8,
            "minimum": 3,
            "maximum": 180,
            "multipleOf": 1,
            "x-ui": {
              "group": "Фарм",
              "order": 50,
              "unit": "сек",
              "control": "dual_range",
              "range": {"id": "hold", "role": "from"}
            }
          },
          "hold_to": {
            "type": "integer",
            "title": "Удержание позиции",
            "description": "Секунд до закрытия. Каждый круг своё время.",
            "default": 55,
            "minimum": 3,
            "maximum": 180,
            "multipleOf": 1,
            "x-ui": {
              "group": "Фарм",
              "order": 60,
              "unit": "сек",
              "control": "dual_range",
              "range": {"id": "hold", "role": "to"}
            }
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "id": "flatten",
      "name": "Закрыть всё",
      "description": "Снимает ордера и закрывает открытые позиции. Новый вход не ставит.",
      "risk": "testnet_write",
      "account_mode": "one_or_more",
      "permissions": {
        "secrets": ["evm_private_key", "proxy"]
      },
      "resources": {
        "account": ["private_key", "proxy"],
        "settings": []
      },
      "output": {
        "mode": "account_table",
        "title": "Закрытие",
        "primary_kind": "account_summary",
        "columns": [
          {"key": "transactions", "title": "Tx", "type": "integer", "aggregate": "sum"},
          {"key": "style", "title": "Стиль", "type": "string"}
        ]
      },
      "options": {
        "type": "object",
        "properties": {
          "account_concurrency": {
            "type": "integer",
            "title": "Параллельные аккаунты",
            "description": "Сколько кошельков закрывать сразу. 20 — все выбранные.",
            "default": 2,
            "minimum": 1,
            "maximum": 20,
            "multipleOf": 1,
            "x-ui": {"group": "Выполнение", "order": 0, "unit": "аккаунтов"}
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "id": "inspect",
      "name": "Парсинг",
      "description": "Читает ETH, test USDC, позиции, ордера и накопленный объём. Транзакций нет.",
      "risk": "read",
      "account_mode": "one_or_more",
      "permissions": {
        "secrets": ["evm_private_key", "proxy"]
      },
      "resources": {
        "account": ["private_key", "proxy"],
        "settings": []
      },
      "output": {
        "mode": "account_table",
        "title": "Портфель Fairground",
        "primary_kind": "account_snapshot",
        "columns": [
          {"key": "eth", "title": "ETH", "type": "decimal_string"},
          {"key": "usdc", "title": "USDC", "type": "decimal_string"},
          {"key": "waitlist", "title": "WL", "type": "boolean"},
          {"key": "volume", "title": "Объём", "type": "decimal_string"},
          {"key": "trades", "title": "Сделок", "type": "integer", "aggregate": "sum"},
          {"key": "positions", "title": "Позиции", "type": "integer", "aggregate": "sum"},
          {"key": "orders", "title": "Ордера", "type": "integer"}
        ]
      },
      "options": {
        "type": "object",
        "properties": {
          "account_concurrency": {
            "type": "integer",
            "title": "Параллельные аккаунты",
            "description": "Сколько кошельков читать сразу. 20 — все выбранные.",
            "default": 5,
            "minimum": 1,
            "maximum": 20,
            "multipleOf": 1,
            "x-ui": {"group": "Выполнение", "order": 0, "unit": "аккаунтов"}
          }
        },
        "required": [],
        "additionalProperties": false
      }
    }
  ],
  "ui": {
    "accent": "#8B5A2B",
    "monogram": "FG"
  }
}
